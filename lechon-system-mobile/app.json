{
  "expo": {
    "name": "Yumi's Lechon",
    "slug": "yumis-lechon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F4"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F4",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.ronnvelsteam.lechonsystemmobile",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "6a449890-600d-4e69-afd5-a800438de869"
      }
    }
  }
}
